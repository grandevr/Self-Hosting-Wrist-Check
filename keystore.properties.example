# Copy to keystore.properties (gitignored) to sign release builds with your own key.
# Use the same keystore for every build, or `adb install -r` refuses the update
# (INSTALL_FAILED_UPDATE_INCOMPATIBLE). Paths are relative to the project root.
storeFile=wrist-check.jks
storePassword=change-me
keyAlias=wrist-check
keyPassword=change-me
