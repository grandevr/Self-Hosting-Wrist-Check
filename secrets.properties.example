# Optional. Without this file the app builds fine and you set it up on the watch
# (tap the complication, scan the QR code, enter the URL and token in your phone's browser).
# With it, these values are built in as a default until something is set up on the watch.
# Copy to secrets.properties (never commit or share it, or an APK built with it) and fill in both.
STATUS_URL=https://example.com/health/status.json
STATUS_TOKEN=paste-the-64-character-token-here
